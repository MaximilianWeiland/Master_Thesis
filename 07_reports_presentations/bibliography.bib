	pages = {323--351},
	file = {Full Text PDF:/Users/maxweiland/Zotero/storage/VNSERUZN/Stubager und Thau - 2025 - How do voters interpret social class appeals Lessons from open-ended responses.pdf:application/pdf},
}

@article{thau_group_2024,
	title = {The {Group} {Appeal} {Strategy}: {Beyond} the {Policy} {Perspective} on {Party} {Electoral} {Success}},
