	pages = {746--762},
	file = {Full Text PDF:/Users/maxweiland/Zotero/storage/FR3EPNWJ/Rudolph und Däubler - 2016 - Holding Individual Representatives Accountable Th.pdf:application/pdf},
}

@article{shugart_looking_2005,
