	file = {Full Text PDF:/Users/maxweiland/Zotero/storage/374653CB/Licht und Sczepanski - 2025 - Detecting Group Mentions in Political Rhetoric A Supervised Learning Approach.pdf:application/pdf;Supplementary Material:/Users/maxweiland/Zotero/storage/DZ9DA8GC/S0007123424000954sup001.pdf:application/pdf},
}

